# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://affiliate:affiliate@localhost:5432/affiliate?schema=public"

# HMAC secret for the session cookie. Use at least 16 random characters.
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional fallback origin for referral links when the request has no Host header.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
